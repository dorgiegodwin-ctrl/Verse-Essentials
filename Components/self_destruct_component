
<# An incredibly basic component intened to be added to oneshot entities that for example may spawn a single wave of vfx or a single sound. 
The point of this comp is to keep your sessions clean by automatically disposing of unused entities after a period of time #>

self_destruction_component <public> := class <final_super> (component):

    @editable var AliveTime : float = 1.0

    OnSimulate <override> ()<suspends> : void =
        (super:)OnSimulate()
        Sleep(AliveTime)
        Entity.RemoveFromParent()
