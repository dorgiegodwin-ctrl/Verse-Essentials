using. /Verse.org
using. /Verse.org/Simulation
using. /Verse.org/SceneGraph
using. /Fortnite.com/Devices
using. /Fortnite.com/Game
using. /Fortnite.com/Characters
using. /Fortnite.com/Playspaces


game_manager_component <public> := class <final_super> (component):

    OnBeginSimulation<override>():void =

        (super:)OnBeginSimulation()

        if. FortRoundManager := Entity.GetFortRoundManager[] then: 
            FortRoundManager.SubscribeRoundStarted(RoundStarted)

    RoundStarted () : void =
        if. Playspace := Entity.GetPlayspaceForEntity[] then: 
            for(Player : Playspace.GetPlayers()):
                InitPlayer(Player)
            Playspace.PlayerAddedEvent().Subscribe(InitPlayer)

    InitPlayer (Player : player) : void =
        if: 
            FC := Player.GetFortCharacter[] 
            FCEntity := FC.GetEntity[] 
        then:
            PlayerComp := player_component{Entity := entity{}}
            FCEntity.AddComponents(array. PlayerComp)    
            PlayerComp.UpdatePlayerReference(Player)
